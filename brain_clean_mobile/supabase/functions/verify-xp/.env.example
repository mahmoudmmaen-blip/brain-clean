# Supabase Edge Function secrets — copy values to Supabase Dashboard
# (Project Settings → Edge Functions → Secrets) or use:
#   supabase secrets set XP_HMAC_SECRET=your_secret_here

XP_HMAC_SECRET=your_hmac_secret_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
