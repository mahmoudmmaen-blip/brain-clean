# Copy this file to `.env` at the repo root (gitignored) before
# `flutter analyze` / `flutter test` / `flutter run`.
#   copy .env.example .env
#
# Prefer real secrets via --dart-define in release builds.
# Never commit `.env`. Placeholder values below are invalid and
# treated as missing by AppConfig.
#
# Server-only (never dart-define these into the APK):
#   CLAUDE_API_KEY          → Supabase Edge secret, rotate in dashboard
#   SUPABASE_SERVICE_ROLE_KEY / JWT_SECRET → Edge runtime only
#   NVIDIA / nvapi keys     → not used; do not add
# XP_HMAC_SECRET is local tamper-evidence only; XP writes are authorized by JWT.
#
# Paused project to restore:
#   https://supabase.com/dashboard/project/fqnlqkkgscmflmunxtwj
# Then set:
#   SUPABASE_URL=https://fqnlqkkgscmflmunxtwj.supabase.co
#   SUPABASE_ANON_KEY=<Project Settings → API → anon public>
# Release builds should still pass both via --dart-define.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_key_here
REVENUECAT_API_KEY=your_revenuecat_public_api_key_here
REVENUECAT_ANDROID_API_KEY=your_revenuecat_android_key_here
REVENUECAT_IOS_API_KEY=your_revenuecat_ios_key_here
XP_HMAC_SECRET=your_hmac_secret_here
ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
ADMOB_ANDROID_BANNER_AD_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
ADMOB_IOS_BANNER_AD_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
