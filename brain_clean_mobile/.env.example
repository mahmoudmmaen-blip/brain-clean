# Environment documentation for Brain Clean Mobile.
# Prefer release/runtime secrets via dart-define (never commit real keys).
#
# Debug / local:
#   flutter run --dart-define=SUPABASE_URL=https://xxxx.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=eyJhbGciOi... \
#     --dart-define=REVENUECAT_API_KEY=goog_...
#
# Play release appbundle (paste real values locally; do not commit them):
#   flutter build appbundle --release \
#     --dart-define=SUPABASE_URL=https://xxxx.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=eyJhbGciOi... \
#     --dart-define=REVENUECAT_API_KEY=goog_...
#
# Offline / no-secrets verification (cloud + billing safely skipped):
#   flutter build appbundle --release
#
# Placeholder values below are intentionally invalid and ignored at runtime.

REVENUECAT_API_KEY=your_revenuecat_public_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_key_here
XP_HMAC_SECRET=your_hmac_secret_here
