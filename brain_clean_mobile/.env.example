# Environment documentation for Brain Clean Mobile.
# Prefer release/runtime secrets via dart-define (never commit real keys).
#
# Debug / local (RevenueCat + AdMob test IDs by default):
#   flutter run --dart-define=REVENUECAT_API_KEY=goog_...
#
# RevenueCat (Local Pro RC):
#   Offering: default
#   Packages: monthly (brainclean_monthly), annual (brainclean_yearly)
#   Entitlement ids accepted: `Brain Clean` (live) and `pro` (alias)
#   Display name: Brain Clean Pro
#
# AdMob (Safe Footer Banner RC — Free users only, Pro hides ads):
#   Banner unit ID: Dart AdsConfig via --dart-define=ADMOB_ANDROID_BANNER_AD_UNIT_ID
#   Android App ID: AndroidManifest meta-data via Gradle manifestPlaceholders["admobAppId"]
#     - Same --dart-define=ADMOB_ANDROID_APP_ID is read by android/app/build.gradle.kts
#     - Fallback (debug / missing): Google test App ID ca-app-pub-3940256099942544~3347511713
#   Override for Internal Testing / production:
#     --dart-define=ADMOB_ANDROID_APP_ID=ca-app-pub-xxx~yyy
#     --dart-define=ADMOB_ANDROID_BANNER_AD_UNIT_ID=ca-app-pub-xxx/yyy
#     --dart-define=ADMOB_IOS_APP_ID=ca-app-pub-xxx~yyy
#     --dart-define=ADMOB_IOS_BANNER_AD_UNIT_ID=ca-app-pub-xxx/yyy
#
# Play Internal Testing AAB (paste real values locally; do not commit them):
#   flutter build appbundle --release \
#     --dart-define=REVENUECAT_API_KEY=goog_... \
#     --dart-define=ADMOB_ANDROID_APP_ID=ca-app-pub-xxx~yyy \
#     --dart-define=ADMOB_ANDROID_BANNER_AD_UNIT_ID=ca-app-pub-xxx/yyy
#
# Offline / no-secrets verification (billing + ads safely skipped or test IDs):
#   flutter build appbundle --release
#
# Placeholder values below are intentionally invalid and ignored at runtime.

REVENUECAT_API_KEY=your_revenuecat_public_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_key_here
XP_HMAC_SECRET=your_hmac_secret_here
ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
ADMOB_ANDROID_BANNER_AD_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
ADMOB_IOS_BANNER_AD_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
