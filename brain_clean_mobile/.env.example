# Environment documentation for Brain Clean Mobile.
# Prefer release/runtime secrets via dart-define (never commit real keys):
#
#   flutter run --dart-define=SUPABASE_URL=https://xxxx.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=eyJ... \
#     --dart-define=REVENUECAT_API_KEY=goog_...
#
# Placeholder values below are intentionally invalid and will be ignored
# at runtime (offline / billing-skipped mode). Copy patterns only.

REVENUECAT_API_KEY=your_revenuecat_public_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_key_here
XP_HMAC_SECRET=your_hmac_secret_here
